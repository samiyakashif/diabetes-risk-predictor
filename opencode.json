{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "figma-console": {
      "type": "local",
      "command": ["npx", "-y", "figma-console-mcp@latest"],
      "enabled": true,
      "environment": {
        "FIGMA_ACCESS_TOKEN": "{env:FIGMA_ACCESS_TOKEN}",
        "ENABLE_MCP_APPS": "true"
      }
    }
  }
}